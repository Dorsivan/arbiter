# LLM backend: "openai" (vLLM/chat-completions) or "anthropic" (Claude)
LLM_BACKEND=openai

# vLLM endpoint (when LLM_BACKEND=openai)
OPENAI_API_BASE=http://localhost:8000/v1
OPENAI_API_KEY=EMPTY
MODEL_NAME=your-model-name

# Claude (when LLM_BACKEND=anthropic)
# ANTHROPIC_API_KEY=your-api-key
# MODEL_NAME=claude-opus-4-6

# --- MLflow SDK example (app/) ---
MLFLOW_TRACKING_URI=https://<dashboard-url>/mlflow
MLFLOW_TRACKING_TOKEN=  # $(oc whoami --show-token), or MLFLOW_TRACKING_AUTH=kubernetes-namespaced in a pod
MLFLOW_WORKSPACE=<project-name>
MLFLOW_EXPERIMENT_NAME=arbiter

# --- Pure OTel example (app_otel/) ---
# MLFLOW_EXPERIMENT_ID=0  # create experiment in MLflow UI first, use its ID

# --- Evaluation judges ---
# JUDGE_MODEL_NAME=  # defaults to MODEL_NAME
# JUDGE_MODEL_URL=   # defaults to OPENAI_API_BASE
# JUDGE_API_KEY=     # defaults to OPENAI_API_KEY

# App settings (optional)
APP_HOST=0.0.0.0
APP_PORT=8000

# --- Workshop: prompt registry ---
ARBITER_PROMPT_SOURCE=registry   # or "code"
ARBITER_PROMPT_ALIAS=production
ARBITER_PROMPT_CACHE_TTL=30
ARBITER_TEMPERATURE=0.2
