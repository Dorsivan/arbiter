# vLLM endpoint (OpenAI-compatible chat completions)
OPENAI_API_BASE=http://localhost:8000/v1
OPENAI_API_KEY=EMPTY
MODEL_NAME=your-model-name

# MLflow (OpenShift AI)
MLFLOW_TRACKING_URI=https://<dashboard-url>/mlflow
MLFLOW_TRACKING_TOKEN=  # $(oc whoami --show-token)
MLFLOW_WORKSPACE=<project-name>

# App settings (optional)
MLFLOW_EXPERIMENT_NAME=arbiter
APP_HOST=0.0.0.0
APP_PORT=8000
